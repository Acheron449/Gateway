# Gateway Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# Environment Profile: local, test, paper, production
GATEWAY_ENV=local

# Execution Mode: paper (live execution not available)
GATEWAY_EXECUTION_MODE=paper

# Phase 6 — OpenBB Open-Data Integration (AGPLv3 — legal review required before prod)
ENABLE_OPENBB_DATA=false
ENABLE_OPENBB_SERVER=false

# Market Data Provider: alpaca, yfinance
MARKET_DATA_PROVIDER=alpaca

# Alpaca API Credentials (paper trading)
# Get from https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_STOCK_FEED=iex  # or sip for paid tier

# Finnhub API Key (for news/calendar)
# Get from https://finnhub.io/dashboard
FINNHUB_API_KEY=

# London Strategic Edge API Key (free market-data vault: history + quotes)
# Get from https://londonstrategicedge.com/data
LSE_API_KEY=

# Database (for local development with SQLite, leave empty)
# For PostgreSQL: postgresql://user:pass@localhost:5432/dbname
DATABASE_URL=

# Provider Encryption Key (32-byte base64)
# Generate with: python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
GATEWAY_PROVIDER_KEY=

# API Key Encryption Key (32-byte base64, for Flask app user API keys)
# Generate with: python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
QUANT_API_ENCRYPTION_KEY=

# Flask Secret (for legacy Flask app)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
QUANT_FRONTEND_SECRET=

# JWT Secret Key (for FastAPI authentication)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=

# SMTP Configuration (for email notifications)
QUANT_SMTP_HOST=
QUANT_SMTP_PORT=587
QUANT_SMTP_USERNAME=
QUANT_SMTP_PASSWORD=
QUANT_SMTP_FROM=no-reply@gateway.local

# Risk Configuration (optional, defaults shown)
RISK_MAX_CONCENTRATION_INSTRUMENT=0.10
RISK_MAX_CONCENTRATION_SECTOR=0.20
RISK_MAX_CONCENTRATION_ASSET_CLASS=0.50
RISK_MAX_GROSS_EXPOSURE=2.0
RISK_MAX_NET_EXPOSURE=1.0
RISK_DAILY_LOSS_LIMIT_PCT=0.05
RISK_ENABLE_MARGIN=false
RISK_MARGIN_MULTIPLIER=2.0
RISK_BLOCKED_INSTRUMENTS=
RISK_EVENT_BLACKOUT_MINUTES=15

# --- Data freshness (seconds) -------------------------------------------
# How long quotes/prices may be cached before the selected provider is
# called again. Lower = fresher data, higher = gentler on free data feeds.
GATEWAY_QUOTES_TTL=10
GATEWAY_PRICE_TTL=10

# --- Kronos forecasting (optional, install from the Markets page) -------
# KRONOS_REPO_PATH=quant-app-v1/backend/vendor/Kronos

# --- Deployment ----------------------------------------------------------
# Backend URL baked into the frontend build (Vercel / Cloudflare Pages).
# Leave empty for same-origin reverse-proxied deployments.
VITE_API_BASE=

# Supabase (hosted Postgres) — see docs/deployment.md and supabase/schema.sql
SUPABASE_URL=
SUPABASE_ANON_KEY=