# Docker Compose Environment Configuration
# This file is used by docker-compose.yml for non-secret configuration
# Secrets are loaded from ./secrets/ directory via Docker secrets

# Backend API
# DATABASE_URL is constructed in docker-compose.yml from secrets
# PYTHONUNBUFFERED=1

# Optional: API Keys and credentials (can also be set via provider registry UI)
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=

# Market Data Provider
MARKET_DATA_PROVIDER=alpaca

# Execution Mode
GATEWAY_EXECUTION_MODE=paper
GATEWAY_ENV=production

# Risk Configuration
RISK_MAX_CONCENTRATION_INSTRUMENT=0.10
RISK_MAX_CONCENTRATION_SECTOR=0.20
RISK_MAX_CONCENTRATION_ASSET_CLASS=0.50
RISK_MAX_GROSS_EXPOSURE=2.0
RISK_MAX_NET_EXPOSURE=1.0
RISK_DAILY_LOSS_LIMIT_PCT=0.05
RISK_ENABLE_MARGIN=false
RISK_MARGIN_MULTIPLIER=2.0
RISK_BLOCKED_INSTRUMENTS=
RISK_EVENT_BLACKOUT_MINUTES=15