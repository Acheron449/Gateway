# Database credentials (for Docker Compose only — NEVER commit to Git!)
# For production: use Docker secrets or environment variables from a secure vault.

POSTGRES_USER=quantuser
POSTGRES_PASSWORD=quantpass
POSTGRES_DB=quantdb

# Backend API
DATABASE_URL=postgresql://quantuser:[REDACTED]@postgres:5432/quantdb

# Optional: API Keys and credentials
# ALPACA_API_KEY=your_key_here
# ALPACA_SECRET_KEY=your_secret_here
