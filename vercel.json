{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "quant-app-v1/frontend/",
      "framework": "vite",
      "installCommand": "npm ci",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "rewrites": [
        { "source": "/(.*)", "destination": "/index.html" }
      ]
    },
    "backend": {
      "root": "quant-app-v1/backend/",
      "framework": "fastapi",
      "entrypoint": "app.main:app"
    }
  },
  "rewrites": [
    { "source": "/auth", "destination": { "service": "backend" } },
    { "source": "/auth/:path*", "destination": { "service": "backend" } },
    { "source": "/catalogue", "destination": { "service": "backend" } },
    { "source": "/catalogue/:path*", "destination": { "service": "backend" } },
    { "source": "/news", "destination": { "service": "backend" } },
    { "source": "/news/:path*", "destination": { "service": "backend" } },
    { "source": "/filings", "destination": { "service": "backend" } },
    { "source": "/filings/:path*", "destination": { "service": "backend" } },
    { "source": "/quote", "destination": { "service": "backend" } },
    { "source": "/quote/:path*", "destination": { "service": "backend" } },
    { "source": "/quotes", "destination": { "service": "backend" } },
    { "source": "/quotes/:path*", "destination": { "service": "backend" } },
    { "source": "/history", "destination": { "service": "backend" } },
    { "source": "/history/:path*", "destination": { "service": "backend" } },
    { "source": "/market", "destination": { "service": "backend" } },
    { "source": "/market/:path*", "destination": { "service": "backend" } },
    { "source": "/health", "destination": { "service": "backend" } },
    { "source": "/health/:path*", "destination": { "service": "backend" } },
    { "source": "/strategies", "destination": { "service": "backend" } },
    { "source": "/strategies/:path*", "destination": { "service": "backend" } },
    { "source": "/journal", "destination": { "service": "backend" } },
    { "source": "/journal/:path*", "destination": { "service": "backend" } },
