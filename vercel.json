    { "source": "/risk/:path*", "destination": { "service": "backend" } },
    { "source": "/divergence", "destination": { "service": "backend" } },
    { "source": "/divergence/:path*", "destination": { "service": "backend" } },
    { "source": "/settings", "destination": { "service": "backend" } },
